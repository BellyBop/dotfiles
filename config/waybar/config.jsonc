{
    "layer": "top",
    "position": "top",
    "margin-top": 8,
    "margin-left": 8,
    "margin-right": 8,
    "fixed-center": true,
    "height": 40,

    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["clock"],
    "modules-right": ["mpris", "wireplumber", "cpu","custom/gpu","memory", "tray"],

    "hyprland/workspaces": {
        "format": "{icon}",
        "on-click": "activate",
        "on-scroll-up": "hyprctl dispatch workspace e+1",
        "on-scroll-down": "hyprctl dispatch workspace e-1",
        "format-icons": {
            "active": "●",
            "default": "○"
        }
    },

    "clock": {
        "format": "{:%a %d %b   %H:%M}",
        "interval": 60,
        "tooltip": false
    },

    "cpu": {
        "format": "<span color='#cba6f7'></span> {usage}%",
        "interval": 2
    },

    "custom/gpu": {
        "format": "<span color='#cba6f7'>󰨇</span> {}",
        "interval": 2,
        "tooltip": true,
        "return-type": "json",
        "exec": "nvidia-smi --query-gpu=utilization.gpu,temperature.gpu,memory.used,memory.total,power.draw --format=csv,noheader,nounits | awk -F', ' '{printf \"{\\\"text\\\":\\\"%s%%\\\",\\\"tooltip\\\":\\\"Temp: %s°C\\\\nVRAM: %.1f/%.1fGB\\\\nPower: %sW\\\"}\", $1, $2, $3/1024, $4/1024, $5}'"
    },

    "memory": {
        "format": "<span color='#cba6f7'></span> {percentage}%",
        "interval": 2
    },

    "wireplumber": {
        "format": "<span color='#cba6f7'>󰕾</span> {volume}%",
        "format-muted": "<span color='#cba6f7'>󰖁</span>",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
    },

    "mpris": {
    "format": "<span color='#cba6f7'>󰎆</span> {title} - {artist}",
    "format-paused": "<span color='#cba6f7'>󰏸</span> {title} - {artist}",
    "max-length": 40,
    "interval": 1,
    "player": "spotify"
    },

    "tray": {
        "spacing": 8
    }
}
