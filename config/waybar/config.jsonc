{
    "layer": "top",
    "position": "top",
    "margin-top": 8,
    "margin-left": 8,
    "margin-right": 8,
    "fixed-center": true,
    "height": 40,

    "modules-left": ["group/workspaces"],
    "modules-center": ["clock"],
    "modules-right": ["mpris", "wireplumber", "cpu","custom/gpu","memory", "tray"],

    "group/workspaces": {
        "orientation": "horizontal",
        "modules": ["custom/ws-listen", "custom/ws1", "custom/ws2", "custom/ws3", "custom/ws4", "custom/ws5", "custom/ws6", "custom/ws7", "custom/ws8", "custom/ws9", "custom/ws10"]
    },
    "custom/ws-listen": { "exec": "~/.config/waybar/scripts/ws-listen.py", "format": "" },
    "custom/ws1": { "exec": "~/.config/waybar/scripts/ws.sh 1", "return-type": "json", "interval": "once", "signal": 8, "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 1 })'", "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'", "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'" },
    "custom/ws2": { "exec": "~/.config/waybar/scripts/ws.sh 2", "return-type": "json", "interval": "once", "signal": 8, "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 2 })'", "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'", "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'" },
    "custom/ws3": { "exec": "~/.config/waybar/scripts/ws.sh 3", "return-type": "json", "interval": "once", "signal": 8, "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 3 })'", "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'", "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'" },
    "custom/ws4": { "exec": "~/.config/waybar/scripts/ws.sh 4", "return-type": "json", "interval": "once", "signal": 8, "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 4 })'", "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'", "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'" },
    "custom/ws5": { "exec": "~/.config/waybar/scripts/ws.sh 5", "return-type": "json", "interval": "once", "signal": 8, "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 5 })'", "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'", "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'" },
    "custom/ws6": { "exec": "~/.config/waybar/scripts/ws.sh 6", "return-type": "json", "interval": "once", "signal": 8, "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 6 })'", "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'", "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'" },
    "custom/ws7": { "exec": "~/.config/waybar/scripts/ws.sh 7", "return-type": "json", "interval": "once", "signal": 8, "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 7 })'", "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'", "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'" },
    "custom/ws8": { "exec": "~/.config/waybar/scripts/ws.sh 8", "return-type": "json", "interval": "once", "signal": 8, "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 8 })'", "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'", "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'" },
    "custom/ws9": { "exec": "~/.config/waybar/scripts/ws.sh 9", "return-type": "json", "interval": "once", "signal": 8, "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 9 })'", "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'", "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'" },
    "custom/ws10": { "exec": "~/.config/waybar/scripts/ws.sh 10", "return-type": "json", "interval": "once", "signal": 8, "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 10 })'", "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'", "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'" },


    "clock": {
        "format": "{:%a %d %b   %H:%M}",
        "interval": 60,
        "tooltip": false
    },

    "cpu": {
        "format": "<span color='#cba6f7'></span> {usage}%",
        "interval": 2
    },

    "custom/gpu": {
        "format": "<span color='#cba6f7'>󰨇</span> {}",
        "interval": 2,
        "tooltip": true,
        "return-type": "json",
        "exec": "nvidia-smi --query-gpu=utilization.gpu,temperature.gpu,memory.used,memory.total,power.draw --format=csv,noheader,nounits | awk -F', ' '{printf \"{\\\"text\\\":\\\"%s%%\\\",\\\"tooltip\\\":\\\"Temp: %s°C\\\\nVRAM: %.1f/%.1fGB\\\\nPower: %sW\\\"}\", $1, $2, $3/1024, $4/1024, $5}'"
    },

    "memory": {
        "format": "<span color='#cba6f7'></span> {percentage}%",
        "interval": 2
    },

    "wireplumber": {
        "format": "<span color='#cba6f7'>󰕾</span> {volume}%",
        "format-muted": "<span color='#cba6f7'>󰖁</span>",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
    },

    "mpris": {
    "format": "<span color='#cba6f7'>󰎆</span> {title} - {artist}",
    "format-paused": "<span color='#cba6f7'>󰏸</span> {title} - {artist}",
    "max-length": 40,
    "interval": 1,
    "player": "spotify"
    },

    "tray": {
        "spacing": 8
    }
}
